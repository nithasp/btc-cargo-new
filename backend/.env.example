# Copy to .env and fill in. The server refuses to start when a required value is missing.

# Environment: dev | test | production
ENV=dev

# Database — set DATABASE_URL (managed provider), or the POSTGRES_* values (local Docker)
# DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=btc_cargo_dev
POSTGRES_TEST_DB=btc_cargo_test
POSTGRES_USER=btc_cargo_user
POSTGRES_PASSWORD=btc_cargo_pass

# TLS to the database: off (local) | verify | no-verify (provider with a self-signed certificate)
DATABASE_SSL=off
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Secrets — REQUIRED, at least 32 characters each. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=
PASSWORD_PEPPER=
SALT_ROUNDS=10

# JWT session
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY_DAYS=7
# strict | lax | none. Defaults to none under ENV=production (frontend and API on different sites)
REFRESH_COOKIE_SAMESITE=

# Server
PORT=3000
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGIN=http://localhost:4200
# Public address of this API, used in report links. Defaults to http://localhost:PORT
PUBLIC_URL=
TRUST_PROXY=1
# LOG_LEVEL=info

# Limits (optional)
API_RATE_LIMIT=1000
AUTH_RATE_LIMIT=30
JSON_BODY_LIMIT=1mb

# Cloudflare R2 Object Storage — fill all four to store uploads in R2.
# While they are empty, uploads are written to UPLOAD_DIR on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# Social login — leave empty to keep a provider switched off
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINE_CHANNEL_ID=

# Demo: seconds before a submitted verification or payment is approved automatically (0 = never)
DEMO_AUTO_APPROVE_SECONDS=60

# Guest entry: POST /api/auth/demo/ signs a visitor in as DEMO_USERNAME without a password, which
# is what lets the web app open straight inside the portal. Set to false to require a real login.
DEMO_LOGIN_ENABLED=true

# Demo account created by `npm run seed`
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
DEMO_EMAIL=demo@btc-cargo.local
